# Frontend Configuration
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_ENVIRONMENT=development

# Supabase — leave empty to use in-memory mock data only
# When set, all task/project/chat/notification data persists to Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp Integration
REACT_APP_WHATSAPP_PHONE_ID=
REACT_APP_WHATSAPP_ACCOUNT_ID=
REACT_APP_WHATSAPP_WEBHOOK_TOKEN=

# Telegram Integration
REACT_APP_TELEGRAM_BOT_TOKEN=
REACT_APP_TELEGRAM_BOT_USERNAME=
REACT_APP_TELEGRAM_WEBHOOK_URL=http://localhost:3000/webhook/telegram

# Optional: Authentication
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_AUTH_DOMAIN=
