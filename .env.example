# Supabase — leave empty to use in-memory mock data only.
# When set, all task/project/chat/notification data persists to Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — URL of the Purple Bee bot socket server (Telegram / in-app chat).
# The frontend socket client (chatStore, botSocket) reads this; it defaults to
# http://localhost:3000 when unset. That server is not yet deployed, so leave
# this empty for the standard static-site build.
# VITE_API_URL=
