# ═══════════════════════════════════════════════════════════════════
# PurpleBee environment template
# Copy to `.env` and fill in values. On Render, set these in the
# dashboard (Environment tab) instead — `.env` is for local dev only.
# ═══════════════════════════════════════════════════════════════════

# Supabase — leave empty to use in-memory mock data only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Node server (server.js) port — Render injects PORT automatically
PORT=
NODE_ENV=

# ── In-app AI assistant (AI Insights page) ─────────────────────────
# SERVER-ONLY: consumed by the `ai-chat` Supabase Edge Function as
# Supabase secrets (not by any Node process). Apply after editing:
#   grep '^LLM_' .env > /tmp/llm.env && supabase secrets set \
#     --env-file /tmp/llm.env --project-ref <your-project-ref>
# No VITE_/REACT_APP_ prefix — that keeps the key out of the browser
# bundle. Never import these in frontend code.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
# Primary model + automatic fallback on model_not_found — the only place a
# model name ever lives (code reads LLM_MODEL / LLM_FALLBACK_MODEL).
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Optional: reasoning_effort for reasoning models (low/medium/high), omit if
# the model rejects it.
LLM_REASONING_EFFORT=

# Legacy / optional integrations (unused in the current deployment)
REACT_APP_API_URL=
REACT_APP_ENVIRONMENT=
# URL of the Purple Bee bot socket server (Telegram / in-app chat). The
# frontend socket client defaults to http://localhost:3000 when unset; that
# server is not deployed, so leave empty for the standard static build.
VITE_API_URL=
REACT_APP_WHATSAPP_PHONE_ID=
REACT_APP_WHATSAPP_ACCOUNT_ID=
REACT_APP_WHATSAPP_WEBHOOK_TOKEN=
REACT_APP_TELEGRAM_BOT_TOKEN=
REACT_APP_TELEGRAM_BOT_USERNAME=
REACT_APP_TELEGRAM_WEBHOOK_URL=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_AUTH_DOMAIN=
