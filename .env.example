# ═══════════════════════════════════════════════════════════════════
# PurpleBee environment template
# Copy to `.env` and fill in values. On Render, set these in the
# dashboard (Environment tab) instead — `.env` is for local dev only.
# ═══════════════════════════════════════════════════════════════════

# Node server (server.js) — local dev only; Render injects PORT automatically.
PORT=3000
NODE_ENV=development

# Frontend build (Vite)
# VITE_* variables are BAKED INTO THE BUNDLE at BUILD time. Set them in
# Render before the first deploy. Anything with a VITE_ prefix is exposed
# to the browser — NEVER put secrets there.
VITE_API_URL=http://localhost:3000

# Supabase — leave empty to use in-memory mock data only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── WhatsApp / Telegram (ChatBot widget feature flags) ────────────────────
# Vite only exposes variables starting with VITE_ to the browser (the old
# REACT_APP_* names were Vite-ignored in this app). These are used by
# src/components/ChatBot.tsx to show/hide the connectors; treat any
# identifiers here as public (baked into the bundle).
VITE_WHATSAPP_PHONE_ID=
VITE_WHATSAPP_ACCOUNT_ID=
VITE_WHATSAPP_WEBHOOK_TOKEN=
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_WEBHOOK_URL=http://localhost:3000/webhook/telegram

# Optional: Authentication — legacy (no current code reads these)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_API_URL=
REACT_APP_ENVIRONMENT=

# ═══════════════════════════════════════════════════════════════════
# In-app AI assistant (AI Insights page) — SERVER-ONLY
# ═══════════════════════════════════════════════════════════════════
# These are consumed by the `ai-chat` Supabase Edge Function as Supabase
# secrets, NOT by any Vite/Express process and NEVER by the frontend. Do
# NOT add a VITE_/REACT_APP_ prefix — that would expose the value to the
# browser bundle.
#
# Apply after editing (push all LLM_* at once):
#   grep '^LLM_' .env > /tmp/llm.env && \
#   supabase secrets set --env-file /tmp/llm.env --project-ref <your-project-ref>
#
# Verify the live secrets still match this file — the Management API
# returns sha256 hashes of each value, so hash a local value and compare:
#   curl -s https://api.supabase.com/v1/projects/<ref>/secrets \
#     -H "Authorization: Bearer $(cat ~/.supabase/access-token)"
#
# Deployed edge functions that read env/secrets (reference):
#   ai-chat, ai-insights, send-email-notification, send-notification,
#   send-telegram-notification, task-reminders, telegram-link,
#   telegram-notify, telegram-webhook
# (telegram-webhook may use TELEGRAM_WEBHOOK_SECRET; never commit it.)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Primary model (only place a model name lives). gpt-oss is a reasoning
# model — only message.content (the final answer) is returned to the UI.
LLM_MODEL=openai/gpt-oss-120b
# Automatic fallback on model_not_found / pool saturation (429).
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
# Keep hidden reasoning short (low/medium/high). Remove if the model
# rejects this parameter.
LLM_REASONING_EFFORT=low
